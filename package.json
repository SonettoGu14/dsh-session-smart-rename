{
  "name": "dsh-session-smart-rename",
  "version": "0.2.0",
  "type": "module",
  "description": "Smart session rename for DSH: a sidebar action and a model-facing smart_rename_session tool, both naming sessions as \"category · topic\".",
  "license": "MIT",
  "author": "SonettoGu14",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "rename",
    "sidebar",
    "tool",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonettoGu14/dsh-session-smart-rename.git"
  },
  "homepage": "https://github.com/SonettoGu14/dsh-session-smart-rename#readme",
  "bugs": {
    "url": "https://github.com/SonettoGu14/dsh-session-smart-rename/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
